<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.clinic.controller.AdminApprovalController"
           prefWidth="1200"
           prefHeight="700"
           style="-fx-background-image: url('/images/dashboard.jpg');
                  -fx-background-size: cover;
                  -fx-background-position: center center;">

    <VBox alignment="CENTER"
          spacing="25"
          prefWidth="1100"
          maxWidth="1100"
          prefHeight="650"
          maxHeight="650">

        <VBox alignment="CENTER"
              spacing="10"
              maxWidth="760"
              style="-fx-background-color: rgba(255,255,255,0.92);
                     -fx-background-radius: 28;
                     -fx-padding: 25 35 25 35;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 18, 0.2, 0, 4);">

            <Text text="Approve Booking"
                  style="-fx-font-size: 28px;
                         -fx-font-weight: bold;
                         -fx-fill: #1e3a8a;" />

            <Label text="Manage pending appointment requests from patients."
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #6b7280;" />
        </VBox>

        <VBox spacing="18"
              alignment="CENTER"
              style="-fx-background-color: rgba(255,255,255,0.95);
                     -fx-background-radius: 28;
                     -fx-padding: 25;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 18, 0.2, 0, 4);">

            <TextField fx:id="txtSearch"
                       promptText="Search pending appointments..."
                       maxWidth="380"
                       style="-fx-background-radius: 14;
                              -fx-padding: 10 14 10 14;
                              -fx-font-size: 13px;" />

            <TableView fx:id="tablePendingAppointments" prefWidth="1030" prefHeight="420">
                <columns>
                    <TableColumn fx:id="colId" text="No." prefWidth="70"/>
                    <TableColumn fx:id="colPatientName" text="Patient Name" prefWidth="220"/>
                    <TableColumn fx:id="colDoctorName" text="Doctor" prefWidth="150"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
                    <TableColumn fx:id="colTime" text="Time" prefWidth="130"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="180"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER" spacing="15">
                <Button text="Approve"
                        onAction="#handleApprove"
                        style="-fx-background-color: #6fc7b3;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 14;
                               -fx-padding: 10 28 10 28;
                               -fx-cursor: hand;" />

                <Button text="Reject"
                        onAction="#handleReject"
                        style="-fx-background-color: #fb6a6a;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 14;
                               -fx-padding: 10 28 10 28;
                               -fx-cursor: hand;" />

                <Button text="Refresh"
                        onAction="#handleRefresh"
                        style="-fx-background-color: #60a5fa;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 14;
                               -fx-padding: 10 28 10 28;
                               -fx-cursor: hand;" />

                <Button text="Back"
                        onAction="#handleBack"
                        style="-fx-background-color: #7c83f3;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 14;
                               -fx-padding: 10 28 10 28;
                               -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </VBox>
</StackPane>