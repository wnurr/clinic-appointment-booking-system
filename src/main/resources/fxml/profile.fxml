<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.clinic.controller.ProfileController"
            prefWidth="900"
            prefHeight="600"
            style="-fx-background-image: url('/images/dashboard.jpg');
                  -fx-background-size: cover;
                  -fx-background-position: center center;">

    <center>
        <StackPane>
            <VBox alignment="CENTER" spacing="25">
                <padding>
                    <Insets top="40" right="40" bottom="40" left="40"/>
                </padding>

                <!-- Header Card -->
                <VBox alignment="CENTER" spacing="10"
                      maxWidth="650"
                      style="-fx-background-color: rgba(255,255,255,0.95);
                             -fx-background-radius: 20;
                             -fx-padding: 30;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 18, 0.2, 0, 5);">

                    <Text text="My Profile"
                          style="-fx-font-size: 28px;
                                 -fx-font-weight: bold;
                                 -fx-fill: #1f3c88;"/>

                    <Label text="View your personal details below."
                           style="-fx-font-size: 13px;
                                  -fx-text-fill: #6b7280;"/>
                </VBox>

                <!-- Profile Details Card -->
                <VBox spacing="18"
                      alignment="CENTER"
                      maxWidth="650"
                      prefWidth="650"
                      style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-padding: 30;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 12, 0.2, 0, 4);">

                    <HBox alignment="CENTER_LEFT" spacing="15"
                          style="-fx-background-color: #f8fbff;
                                 -fx-background-radius: 12;
                                 -fx-padding: 15;">
                        <Label text="👤"
                               style="-fx-font-size: 20px;"/>
                        <Label fx:id="lblUsername"
                               style="-fx-font-size: 16px;
                                      -fx-text-fill: #1f3c88;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="15"
                          style="-fx-background-color: #f8fbff;
                                 -fx-background-radius: 12;
                                 -fx-padding: 15;">
                        <Label text="📝"
                               style="-fx-font-size: 20px;"/>
                        <Label fx:id="lblFullname"
                               style="-fx-font-size: 15px;
                                      -fx-text-fill: #1f3c88;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="15"
                          style="-fx-background-color: #f8fbff;
                                 -fx-background-radius: 12;
                                 -fx-padding: 15;">
                        <Label text="📞"
                               style="-fx-font-size: 20px;"/>
                        <Label fx:id="lblPhone"
                               style="-fx-font-size: 15px;
                                      -fx-text-fill: #1f3c88;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="15"
                          style="-fx-background-color: #f8fbff;
                                 -fx-background-radius: 12;
                                 -fx-padding: 15;">
                        <Label text="🆔"
                                 style="-fx-font-size: 20px;"/>
                        <Label fx:id="lblNric"
                               style="-fx-font-size: 15px;
                                      -fx-text-fill: #1f3c88;"/>
                    </HBox>

                    <Button text="Back to Dashboard"
                            onAction="#handleBack"
                            prefWidth="180"
                            prefHeight="42"
                            style="-fx-background-color: #4da6ff;
                                   -fx-text-fill: white;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 10;
                                   -fx-cursor: hand;"/>
                </VBox>
            </VBox>
        </StackPane>
    </center>

</BorderPane>