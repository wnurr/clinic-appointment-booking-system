<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.clinic.controller.RegisterController"
           alignment="CENTER"
           styleClass="auth-root">

    <VBox alignment="CENTER"
          spacing="14"
          prefWidth="500"
          maxWidth="500"
          maxHeight="600"
          styleClass="auth-card">
        <padding>
            <Insets top="28" right="32" bottom="28" left="32"/>
        </padding>

        <VBox alignment="CENTER" spacing="6">
            <Text text="Clinic Appointment System" styleClass="auth-title"/>
            <Label text="Create your account" styleClass="auth-subtitle"/>
        </VBox>

        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Username" styleClass="field-label"/>
            <TextField fx:id="txtUsername"
                       promptText="Minimum 4 characters"
                       styleClass="auth-field"/>
        </VBox>

        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Full Name" styleClass="field-label"/>
            <TextField fx:id="txtFullName"
                       promptText="Enter your full name"
                       styleClass="auth-field"/>
        </VBox>

        <HBox spacing="12">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Phone Number" styleClass="field-label"/>
                <TextField fx:id="txtPhone"
                           promptText="e.g. 0123456789"
                           styleClass="auth-field"/>
            </VBox>

            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="NRIC Number" styleClass="field-label"/>
                <TextField fx:id="txtNric"
                           promptText="XXXXXX-XX-XXXX"
                           styleClass="auth-field"/>
            </VBox>
        </HBox>

        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Password" styleClass="field-label"/>
            <StackPane>
                <PasswordField fx:id="txtPassword"
                               promptText="Create a strong password"
                               styleClass="auth-field auth-password-field"/>

                <TextField fx:id="txtPasswordVisible"
                           promptText="Create a strong password"
                           visible="false"
                           managed="false"
                           styleClass="auth-field auth-password-field"/>

                <Button fx:id="iconPassword"
                        text="Show"
                        onAction="#handleTogglePassword"
                        focusTraversable="false"
                        styleClass="password-toggle"
                        StackPane.alignment="CENTER_RIGHT"/>
            </StackPane>
            <Label fx:id="lblPasswordStrength" text="Password strength: " styleClass="helper-label"/>
        </VBox>

        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Confirm Password" styleClass="field-label"/>
            <StackPane>
                <PasswordField fx:id="txtConfirmPassword"
                               promptText="Re-enter your password"
                               styleClass="auth-field auth-password-field"/>

                <TextField fx:id="txtConfirmPasswordVisible"
                           promptText="Re-enter your password"
                           visible="false"
                           managed="false"
                           styleClass="auth-field auth-password-field"/>

                <Button fx:id="iconConfirmPassword"
                        text="Show"
                        onAction="#handleToggleConfirmPassword"
                        focusTraversable="false"
                        styleClass="password-toggle"
                        StackPane.alignment="CENTER_RIGHT"/>
            </StackPane>
            <Label fx:id="lblPasswordMatch" text="" styleClass="helper-label"/>
        </VBox>

        <CheckBox fx:id="chkAgree"
                  text="I agree to the terms and conditions"
                  styleClass="terms-checkbox"/>

        <Button fx:id="btnRegister"
                text="Register"
                onAction="#handleRegister"
                prefWidth="360"
                prefHeight="40"
                styleClass="primary-button auth-button"/>

        <Button text="Back to Login"
                onAction="#handleBack"
                focusTraversable="false"
                prefWidth="360"
                prefHeight="40"
                styleClass="secondary-button auth-button"/>
    </VBox>
</StackPane>