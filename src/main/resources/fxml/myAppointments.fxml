<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.clinic.controller.MyAppointmentsController"
           prefWidth="900"
           prefHeight="600"
           style="-fx-background-image: url('/images/dashboard.jpg');
                  -fx-background-size: cover;
                  -fx-background-position: center center;">

    <VBox alignment="CENTER"
          spacing="18"
          maxWidth="760"
          maxHeight="500"
          style="-fx-background-color: rgba(255,255,255,0.90);
                 -fx-background-radius: 20;
                 -fx-padding: 25;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0.2, 0, 4);">

        <Text text="My Appointments"
              style="-fx-font-size: 28px;
                     -fx-font-weight: bold;
                     -fx-fill: #111827;"/>

        <HBox spacing="12" alignment="CENTER">
            <Label text="Search:"
                   style="-fx-font-size: 14px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #374151;"/>

            <TextField fx:id="txtSearch"
                       promptText="Search by doctor name"
                       prefWidth="220"
                       style="-fx-background-radius: 10;
                              -fx-border-radius: 10;
                              -fx-padding: 8;
                              -fx-background-color: white;
                              -fx-border-color: #d1d5db;"/>

            <Button text="Search"
                    onAction="#handleSearch"
                    style="-fx-background-color: #3b82f6;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;
                           -fx-padding: 8 16;"/>

            <Button text="Reset"
                    onAction="#handleReset"
                    style="-fx-background-color: #94a3b8;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;
                           -fx-padding: 8 16;"/>
        </HBox>

        <TableView fx:id="tableAppointments"
                   prefWidth="650"
                   prefHeight="280"
                   style="-fx-background-radius: 12;
                          -fx-border-radius: 12;">

            <columns>
                <TableColumn fx:id="colId" text="No." prefWidth="70"/>
                <TableColumn fx:id="colDoctorName" text="Doctor Name" prefWidth="180"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
                <TableColumn fx:id="colTime" text="Time" prefWidth="120"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="130"/>
            </columns>
        </TableView>

        <HBox spacing="15" alignment="CENTER">
            <Button text="Cancel Appointment"
                    onAction="#handleCancelAppointment"
                    style="-fx-background-color: #ef4444;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;
                           -fx-padding: 10 18;"/>

            <Button text="Back to Dashboard"
                    onAction="#handleBack"
                    style="-fx-background-color: #0f172a;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;
                           -fx-padding: 10 18;"/>
        </HBox>

    </VBox>

</StackPane>