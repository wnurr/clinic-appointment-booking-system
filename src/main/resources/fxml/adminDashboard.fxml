<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.clinic.controller.AdminDashboardController"
           prefWidth="1200"
           prefHeight="700"
           style="-fx-background-image: url('/images/dashboard.jpg');
                  -fx-background-size: cover;
                  -fx-background-position: center center;">

    <VBox alignment="CENTER"
          spacing="30"
          prefWidth="1100"
          maxWidth="1100">

        <VBox alignment="CENTER"
              spacing="12"
              maxWidth="620"
              style="-fx-background-color: rgba(255,255,255,0.92);
                     -fx-background-radius: 28;
                     -fx-padding: 28 40 28 40;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 18, 0.2, 0, 4);">

            <Text text="Clinic Admin Dashboard"
                  style="-fx-font-size: 30px;
                         -fx-font-weight: bold;
                         -fx-fill: #1e3a8a;" />

            <Label fx:id="welcomeLabel"
                   text="Welcome Admin!"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #374151;" />

            <Label text="Manage users, appointments, and booking approvals efficiently."
                   wrapText="true"
                   alignment="CENTER"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #6b7280;" />
        </VBox>

        <HBox alignment="CENTER" spacing="28">
            <VBox alignment="CENTER"
                  spacing="14"
                  prefWidth="250"
                  prefHeight="220"
                  style="-fx-background-color: rgba(255,255,255,0.95);
                         -fx-background-radius: 26;
                         -fx-padding: 25;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 16, 0.2, 0, 4);">

                <Text text="👥"
                      style="-fx-font-size: 46px;" />

                <Label text="View Users"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1e3a8a;" />

                <Label text="See all registered users including full name, phone number and NRIC."
                       wrapText="true"
                       alignment="CENTER"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: #6b7280;" />

                <Button text="Open"
                        onAction="#handleViewUsers"
                        style="-fx-background-color: #60a5fa;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 14;
                               -fx-padding: 10 34 10 34;
                               -fx-cursor: hand;" />
            </VBox>

            <VBox alignment="CENTER"
                  spacing="14"
                  prefWidth="250"
                  prefHeight="220"
                  style="-fx-background-color: rgba(255,255,255,0.95);
                         -fx-background-radius: 26;
                         -fx-padding: 25;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 16, 0.2, 0, 4);">

                <Text text="📋"
                      style="-fx-font-size: 46px;" />

                <Label text="View Appointments"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1e3a8a;" />

                <Label text="View all booked, approved, rejected, and cancelled appointments."
                       wrapText="true"
                       alignment="CENTER"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: #6b7280;" />

                <Button text="Open"
                        onAction="#handleViewAppointments"
                        style="-fx-background-color: #6fc7b3;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 14;
                               -fx-padding: 10 34 10 34;
                               -fx-cursor: hand;" />
            </VBox>

            <VBox alignment="CENTER"
                  spacing="14"
                  prefWidth="250"
                  prefHeight="220"
                  style="-fx-background-color: rgba(255,255,255,0.95);
                         -fx-background-radius: 26;
                         -fx-padding: 25;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 16, 0.2, 0, 4);">

                <Text text="✔"
                      style="-fx-font-size: 46px;" />

                <Label text="Approve Booking"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1e3a8a;" />

                <Label text="Approve or reject pending appointment requests from patients."
                       wrapText="true"
                       alignment="CENTER"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: #6b7280;" />

                <Button text="Manage"
                        onAction="#handleApproval"
                        style="-fx-background-color: #7c83f3;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 14;
                               -fx-padding: 10 34 10 34;
                               -fx-cursor: hand;" />
            </VBox>

            <VBox alignment="CENTER"
                  spacing="14"
                  prefWidth="250"
                  prefHeight="220"
                  style="-fx-background-color: rgba(255,255,255,0.95);
                         -fx-background-radius: 26;
                         -fx-padding: 25;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 16, 0.2, 0, 4);">

                <Text text="🚪"
                      style="-fx-font-size: 46px;" />

                <Label text="Logout"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1e3a8a;" />

                <Label text="Securely sign out from the admin system."
                       wrapText="true"
                       alignment="CENTER"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: #6b7280;" />

                <Button text="Logout"
                        onAction="#handleLogout"
                        style="-fx-background-color: #fb6a6a;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 14;
                               -fx-padding: 10 34 10 34;
                               -fx-cursor: hand;" />
            </VBox>
        </HBox>

    </VBox>
</StackPane>